# Dependencies
node_modules/
vendor/
venv/
.venv/
__pycache__/

# Build outputs
dist/
build/
target/
bin/
obj/

# Runtime / local caches (can grow to multi-GB; never index)
.data/
**/.data/
**/cwsp-files-blobs/
.worktrees/
**/*.blob

# Logs & temp
*.log
logs/
*.tmp
*.temp
.cache/

# Environment
.env
.env.*
!.env.example
private/
private/*

# IDE
.idea/

# Git history
.git/

# Test coverage
coverage/
.nyc_output/
htmlcov/

# OS
.DS_Store
Thumbs.db

# Cursor - do not pull into context
.cursor/analysis/
.cursor/plans/
.cursor/snapshots/

# Heavy agent dumps (open by path only if the task needs them)
.archives/
.backups/
.superpowers/sdd/

# Token optimization - ignore large unneeded files
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
*.min.js
*.min.css
*.map
*.svg
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
.pantry/
~/.pantry/

