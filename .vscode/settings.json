{
    "nativescript.tnsPath": "tools/ns-vscode.sh",
    "terminal.integrated.env.linux": {
        "ANDROID_HOME": "${env:HOME}/Android/Sdk",
        "PATH": "${env:HOME}/Android/Sdk/platform-tools:${env:HOME}/Android/Sdk/emulator:${env:PATH}"
    },
    "github.copilot.editor.enableAutoCompletions": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false
    },
    "java.configuration.updateBuildConfiguration": "disabled",
    "java.project.sourcePaths": [
        "apps/CWSP/java",
        "apps/CWSAndroid/app/src/main/java"
    ],
    "files.exclude": {
        "**/.data": true,
        "**/cwsp-files-blobs": true,
        "**/.worktrees": true,
        "**/*.blob": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.git/**": true,
        "**/.git/modules/**": true,
        "**/dist/**": true,
        "**/dist-crx/**": true,
        "**/build/**": true,
        "**/.data/**": true,
        "**/cwsp-files-blobs/**": true,
        "**/.worktrees/**": true,
        "**/*.blob": true,
        "**/runtime/cwsp/**": true,
        "**/runtime/node_modules/**": true,
        "**/runtime/legacy/**": true,
        "**/runtime/dist/**": true,
        "**/coverage/**": true,
        "**/.gradle/**": true,
        "**/.android/**": true,
        "**/target/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/dist": true,
        "**/dist-crx": true,
        "**/build": true,
        "**/.data": true,
        "**/cwsp-files-blobs": true,
        "**/.worktrees": true,
        "**/runtime/cwsp": true,
        "**/runtime/node_modules": true,
        "**/runtime/legacy": true,
        "**/coverage": true
    },
    "git.autoFetch": false,
    "git.fetchOnPull": false,
    "git.detectSubmodules": false,
    "git.detectSubmodulesLimit": 0,
    "extensions.autoCheckUpdates": false,
    "typescript.tsserver.maxTsServerMemory": 4096,
    "js/ts.experimental.useTsgo": false,
    "files.saveConflictResolution": "overwriteFileOnDisk",
    "js/ts.preferences.importModuleSpecifierEnding": "minimal",
    "editor.linkedEditing": true,
    "editor.foldingImportsByDefault": true,
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "files.autoSave": "onFocusChange",
    "editor.autoIndentOnPaste": true,
    "files.autoSaveWhenNoErrors": true,
    "files.autoSaveWorkspaceFilesOnly": true,
    "workbench.experimental.cloudChanges.autoStore": "onShutdown",
    "editor.formatOnSave": false,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "interactiveWindow.promptToSaveOnClose": false,
    "notebook.experimental.remoteSave": true,
    "chat.experimentalSessionsWindowOverride": true,
    "js/ts.implicitProjectConfig.checkJs": true,
    "js/ts.implicitProjectConfig.experimentalDecorators": true,
    "terminal.integrated.localEchoEnabled": "auto",
    "markdown.copyFiles.overwriteBehavior": "overwrite",
    "editor.allowVariableFontsInAccessibilityMode": true,
    "terminal.integrated.suggest.insertTrailingSpace": true,
    "editor.formatOnType": false,
    "editor.formatOnPaste": true,
    "terminal.integrated.enableImages": true,
    "eslint.useESLintClass": true,
    "js/ts.implicitProjectConfig.target": "ESNext",
    "python.analysis.enableSnippetExtraTelemetry": true,
    "editor.fontFamily": "'Moonaspace Neon Var', 'Fira Code', Consolas, 'Courier New', monospace",
    "editor.fontSize": 11,
    "terminal.integrated.allowInUntrustedWorkspace": true,
    "editor.unicodeHighlight.includeComments": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.suggest.shareSuggestSelections": true,
    "chat.agent.sandbox.allowNetwork": true,
    "terminal.integrated.allowMnemonics": true,
    "debug.allowBreakpointsEverywhere": true,
    "extensions.allowOpenInModalEditor": true
}