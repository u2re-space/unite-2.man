{
    "include": [
        "**/*.mjs",
        "**/*.js",
        "**/*.ts",
        "**/*.d.ts",
        "**/*.tsx"
    ],
    "exclude": [
        "node_modules/**",
        "dist/**",
        "build/**",
        "coverage/**",
        "logs/**",
        "cache/**",
        "temp/**",
        "tmp/**",
        "runtime/**",
        "**/vite.config.js",
        "**/vite.config.ts",
        "**/vite.config.mjs"
    ],
    "compilerOptions": {
        "outDir": "./dist/",
        "skipLibCheck": true,
        "jsx": "preserve",
        "paths": {
            "/apps/*": [
                "./frontend/apps/*"
            ],
            "/externals/*": [
                "./frontend/externals/*"
            ],
            "/assets/*": [
                "./frontend/assets/*"
            ],
            "/frontend/*": [
                "./frontend/*"
            ],
            "@fest-lib/*": [
                "./modules/shared/fest/*"
            ],
            "@fest-lib/lure": [
                "./modules/projects/lur.e/src/index.ts"
            ],
            "@fest-lib/object": [
                "./modules/projects/object.ts/src/index.ts"
            ],
            "@fest-lib/dom": [
                "./modules/projects/dom.ts/src/index.ts"
            ],
            "@fest-lib/style-lib": [
                "./modules/projects/style.ts/src/index.ts"
            ],
            "@fest-lib/core": [
                "./modules/projects/core.ts/src/index.ts"
            ],
            "@fest-lib/icon": [
                "./modules/projects/icon.ts/src/index.ts"
            ],
            "@fest-lib/uniform": [
                "./modules/projects/uniform.ts/src/index.ts"
            ],
            "@fest-lib/fl-ui": [
                "./modules/projects/fl.ui/src/index.ts"
            ],
            "@fest-lib/ui": [
                "./modules/projects/fl.ui/src/index.ts"
            ],
            "@fl-ui/*": [
                "./modules/projects/fl.ui/src/ui/*"
            ],
            "fl-ui/*": [
                "./modules/projects/fl.ui/src/ui/*"
            ],
            "cwsp-shared/*": [
                "./modules/projects/cwsp-shared/src/*"
            ],
            "@fest-lib/cwsp-shared": [
                "./modules/projects/cwsp-shared/src/index.ts"
            ],
            "com/config/Names": [
                "./modules/projects/subsystem/runtime/names.ts"
            ],
            "com/config/*": [
                "./modules/projects/subsystem/src/other/config/*"
            ],
            "com/core/LogSanitizer": [
                "./modules/projects/subsystem/runtime/log-sanitizer.ts"
            ],
            "com/core/*": [
                "./modules/projects/subsystem/src/routing/channel/*"
            ],
            "com/routing/*": [
                "./modules/projects/subsystem/src/routing/*"
            ]
        },
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker",
            "ESNext.Promise"
        ],
        "types": [
            "chrome"
        ],
        "module": "ESNext",
        "target": "ESNext",
        "moduleDetection": "auto",
        "moduleResolution": "bundler",
        "pretty": true,
        "allowSyntheticDefaultImports": true,
        "allowArbitraryExtensions": true,
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "noEmit": true,
        "rewriteRelativeImportExtensions": true,
        "allowUnusedLabels": true,
        "allowUnreachableCode": true,
        "forceConsistentCasingInFileNames": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "isolatedModules": true,
        "emitDecoratorMetadata": false
    }
}